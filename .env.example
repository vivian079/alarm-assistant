ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_JUDGE_MODEL=claude-sonnet-5-5

# Which version of each to use. Each name is a folder or file that is never edited after use;
# see api/prompts/README.md, eval/judge_prompts/README.md, eval/golden_sets/README.md.
# The API reads PROMPT_VERSION when it starts: restart it after changing this.
PROMPT_VERSION=handling_plan_v6
JUDGE_PROMPT_VERSION=judge_v3
# handling_plan_v7 is the agent version (tools). heldout_v1 is the held-out set:
# run it with docker compose run --rm -e GOLDEN_SET_VERSION=heldout_v1 eval
GOLDEN_SET_VERSION=golden_v2
